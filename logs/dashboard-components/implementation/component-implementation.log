COMPONENT USAGE EXAMPLES
-------------------------

Example 1: QuickInsightCard in Dashboard
```tsx
import { QuickInsightCard } from "@/components/molecules/QuickInsightCard";
import { useDashboardStore } from "@/interface-adapters/store/dashboardStore";

export function DashboardPage() {
  const insight = useDashboardStore((state) => state.currentInsight);
  const refreshDashboard = useDashboardStore((state) => state.refreshDashboard);

  return (
    <QuickInsightCard
      insight={insight}
      onRefresh={refreshDashboard}
    />
  );
}
```

Example 2: StreakDisplay in Dashboard
```tsx
import { StreakDisplay } from "@/components/molecules/StreakDisplay";
import { useDashboardStore } from "@/interface-adapters/store/dashboardStore";

export function DashboardPage() {
  const streak = useDashboardStore((state) => state.currentStreak);

  return <StreakDisplay streak={streak} />;
}
```

Example 3: WeeklySummaryCard in Dashboard
```tsx
import { WeeklySummaryCard } from "@/components/molecules/WeeklySummaryCard";
import { useDashboardStore } from "@/interface-adapters/store/dashboardStore";

export function DashboardPage() {
  const { thisWeekHeadaches, thisWeekCheckins } = useDashboardStore((state) => ({
    thisWeekHeadaches: state.thisWeekHeadaches,
    thisWeekCheckins: state.thisWeekCheckins,
  }));

  return (
    <WeeklySummaryCard
      headacheCount={thisWeekHeadaches}
      checkinCount={thisWeekCheckins}
    />
  );
}
```

